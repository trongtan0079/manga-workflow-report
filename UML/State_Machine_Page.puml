@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Trang Truyện (Page)

skinparam backgroundColor white
skinparam shadowing false
' skinparam linetype ortho

[*] --> drafting : Mangaka tải lên trang vẽ mới

state drafting {
    description : Trang vẽ thô đang biên tập
}

state drawing {
    description : Đang thực hiện vẽ (đang có Task hoạt động)
}

state approved {
    description : Toàn bộ phân vùng (PageRegions) đã hoàn thành và được duyệt
}

state published {
    description : Trang truyện đã xuất bản chính thức cùng Chapter
}

drafting -down-> drawing : Mangaka tạo và giao Task\ntrên phân vùng
drafting -right-> reviewing_draft : Chapter chứa trang\nchuyển sang reviewing_draft
reviewing_draft -left-> drafting : Chapter bị\ntừ chối duyệt nháp
reviewing_draft -down-> drawing : Chapter được duyệt nháp
drawing -right-> reviewing_final : Chapter chứa trang\nchuyển sang reviewing_final
reviewing_final -left-> drawing : Chapter bị từ chối\nduyệt hoàn chỉnh

drawing -down-> approved : Tất cả phân vùng (PageRegions)\nchuyển sang 'completed'\nvà tất cả Task đã hoàn thành
reviewing_final -down-> approved : Chapter được duyệt hoàn chỉnh

approved -down-> published : Chapter chứa trang này\nđược duyệt xuất bản

published -down-> [*]

@enduml
