@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Phân Vùng (Page Region)

skinparam backgroundColor white
skinparam shadowing false
' skinparam linetype ortho

[*] --> pending : Mangaka vẽ phân vùng mới\n[PageRegionController::store()]

state pending {
    description : Vùng vừa được tạo, chưa giao việc
}

state in_progress {
    description : Đã giao Task cho Assistant và đang vẽ
}

state submitted {
    description : Trợ lý đã vẽ xong và gửi nộp bản thảo\n[SubmissionController::store()]
}

state rejected {
    description : Bản thảo trên phân vùng bị Mangaka từ chối\n[ReviewController::store()]
}

state completed {
    description : Bản thảo phân vùng được Mangaka phê duyệt\n[ReviewController::store()]
}

pending -down-> in_progress : Mangaka tạo và giao Task mới\ngắn với vùng [TaskController::store()]

in_progress -down-> submitted : Trợ lý nộp bản thảo\ngắn với vùng [SubmissionController::store()]

submitted -left-> completed : Mangaka phê duyệt bản thảo\n[ReviewController::store() status='approved']
submitted -right-> rejected : Mangaka từ chối bản thảo\n[ReviewController::store() status='rejected']

rejected -up-> in_progress : Trợ lý vẽ lại trên phân vùng này\n[TaskController::updateStatus()]
rejected -up-> pending : Hủy giao việc hoặc giao lại task\ncho người khác [TaskController::update()]

completed -down-> [*]

@enduml
