@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Phân Vùng (Page Region)

skinparam backgroundColor white
skinparam shadowing false
skinparam state {
    BackgroundColor #E8F4F8
    BorderColor #2980B9
    FontSize 13
}
skinparam ArrowFontSize 11

[*] --> pending : Mangaka vẽ thủ công phân vùng mới

pending : Vùng vừa được tạo, chưa giao việc
in_progress : Đã giao Task cho Assistant và đang vẽ
submitted : Assistant đã nộp bản vẽ cho phân vùng này
completed : Bản vẽ trên phân vùng đã được Mangaka phê duyệt (Approved)
rejected : Bản vẽ trên phân vùng bị Mangaka từ chối (Rejected)

pending --> in_progress : Mangaka tạo và giao Task mới gắn với vùng

in_progress --> submitted : Assistant nộp Submission cho Task liên kết

submitted --> completed : Mangaka phê duyệt bản thảo (Approve Submission)
submitted --> rejected : Mangaka từ chối bản thảo (Reject Submission)

rejected --> in_progress : Assistant chỉnh sửa hoặc Mangaka giao lại task
rejected --> submitted : Assistant nộp lại bản thảo mới cho phân vùng

completed --> [*]

@enduml
