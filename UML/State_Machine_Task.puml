@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Task (Công việc Trợ lý)

skinparam backgroundColor white
skinparam shadowing false
' skinparam linetype ortho

[*] --> pending : Mangaka tạo Task mới\n[TaskController::store()]

state pending {
    description : Công việc đang chờ Trợ lý tiếp nhận
}

state in_progress {
    description : Trợ lý đang thực hiện vẽ phác thảo / đi nét / lên màu...
}

state submitted {
    description : Trợ lý đã tải lên bản thảo và gửi nộp\n[SubmissionController::store()]
}

state rejected {
    description : Bản thảo bị Mangaka từ chối, yêu cầu chỉnh sửa\n[ReviewController::store()]
}

state completed {
    description : Công việc hoàn thành xuất sắc \& được Mangaka phê duyệt\n[ReviewController::store()]
}

pending -down-> in_progress : Assistant tiếp nhận / Bắt đầu làm\n[TaskController::updateStatus()]
in_progress -down-> submitted : Assistant nộp bản vẽ\n[SubmissionController::store()]

submitted -left-> completed : Mangaka phê duyệt bản vẽ\n[ReviewController::store() status='approved']
submitted -right-> rejected : Mangaka từ chối bản vẽ\n[ReviewController::store() status='rejected']

rejected -up-> in_progress : Assistant bắt đầu sửa đổi / vẽ lại\n[TaskController::updateStatus()]
rejected -up-> pending : Mangaka giao lại task hoặc đổi người làm\n[TaskController::update()]

completed -down-> [*]

@enduml
