@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Bộ Truyện (Series)

skinparam backgroundColor white
skinparam shadowing false
' skinparam linetype ortho

[*] --> draft : Mangaka tạo Series mới\n[publish_type = 'draft', status = 'planning']

draft --> submitted : Mangaka bấm Nộp đề xuất\n[publish_type = 'submitted', status = 'planning']

state submitted {
    description : Đang nằm trong hàng đợi chờ Editorial Board phê duyệt
}

submitted -down-> ongoing : Editorial Board phê duyệt\n[status = 'ongoing']\n[Bắt buộc gán BTV chuyên trách\n- Tantou Editor]

submitted -right-> canceled : Editorial Board từ chối đề xuất\n[status = 'canceled']

state ongoing {
    description : Bộ truyện đang trong quá trình sáng tác và xuất bản thương mại
}

ongoing -down-> suspended : Editorial Board tạm ngưng phát hành (treo bút)\n[status = 'suspended']

suspended -up-> ongoing : Editorial Board khôi phục trạng thái phát hành\n[status = 'ongoing']

ongoing -left-> completed : Editorial Board\nđánh dấu hoàn thành\n[status = 'completed']\n[Guard: Hết chapter chưa duyệt\nVÀ đã duyệt xong Chương cuối (is_final=1)]

ongoing -right-> canceled : Editorial Board\nhủy phát hành bộ truyện\n[status = 'canceled']

suspended -right-> canceled : Editorial Board\nhủy phát hành bộ truyện\n[status = 'canceled']

completed -down-> [*]
canceled -down-> [*]

@enduml
