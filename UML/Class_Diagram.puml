@startuml
title Manga Creation and Publishing Management System
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ranksep 350
skinparam nodesep 200
top to bottom direction

class Role {
  +roleId : int
  +roleName : string
  +description : string
}

class User {
  +userId : int
  +username : string
  +fullName : string
  +email : string
  +passwordHash : string
  +status : string
}

class Series {
  +seriesId : int
  +title : string
  +description : string
  +status : string
  +coverImage : string
}

class Chapter {
  +chapterId : int
  +chapterNumber : int
  +title : string
  +status : string
  +publishedAt : datetime
}

class Page {
  +pageId : int
  +pageNumber : int
  +imageUrl : string
  +status : string
}

class Task {
  +taskId : int
  +title : string
  +description : string
  +priority : string
  +status : string
  +dueDate : datetime
}

class Submission {
  +submissionId : int
  +fileUrl : string
  +notes : string
  +status : string
  +submittedAt : datetime
}

class Review {
  +reviewId : int
  +comments : string
  +rating : int
  +createdAt : datetime
}

class SeriesRanking {
  +rankingId : int
  +rankPosition : int
  +score : decimal
  +periodStartDate : date
}

class Notification {
  +notificationId : int
  +type : string
  +message : string
  +isRead : boolean
}

Role "1" -down- "*" User : assigned
User "1" -down- "*" Series : creates
Series "1" -down- "*" Chapter : contains
Chapter "1" -down- "*" Page : contains

Chapter "1" -right- "*" Task : requires
User "1" -right- "*" Task : assigns
User "1" -left- "*" Task : receives

Task "1" -right- "*" Submission : generates
Chapter "1" -left- "*" Submission : submitted
User "1" -down- "*" Submission : submits

Submission "1" -down- "*" Review : receives
User "1" -right- "*" Review : writes

Series "1" -down- "*" SeriesRanking : ranked
User "1" -down- "*" SeriesRanking : evaluates
User "1" -down- "*" Notification : receives
@enduml
